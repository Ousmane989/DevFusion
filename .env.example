# ------------------------------------------------------------------
# Karat — variables d'environnement
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# ------------------------------------------------------------------

# Port du serveur
PORT=3000

# Environnement : development | production
NODE_ENV=development

# Secret utilise pour signer les jetons de session (JWT).
# En production, mettez une longue chaine aleatoire unique.
JWT_SECRET=changez-moi-en-production-avec-une-longue-chaine-aleatoire

# Duree de l'essai gratuit, en jours
TRIAL_DAYS=3

# ------------------------------------------------------------------
# Envoi d'e-mails (code de verification, reinitialisation)
# Laissez SMTP_HOST vide pour le mode developpement :
# le code de verification sera alors affiche dans la console du serveur.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Karat <no-reply@karat.mr>"
