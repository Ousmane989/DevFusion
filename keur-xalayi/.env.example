# ---------------------------------------------------------------
# Keur Xalayi — variables d'environnement (copier en .env)
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Base PostgreSQL locale ou Supabase (Project Settings > Database > URI)
DATABASE_URL=postgres://kx:kx@localhost:5432/keurxalayi
# Mettre "true" pour Supabase / hébergeur qui impose SSL
DATABASE_SSL=false

# Secret de signature des sessions (longue chaîne aléatoire)
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Compte directeur créé au premier démarrage (à changer ensuite !)
ADMIN_IDENTIFIANT=directeur
ADMIN_MOT_DE_PASSE=KeurXalayi2026

# Fuseau horaire de l'école (Nouakchott et Dakar = UTC)
TZ=Africa/Nouakchott

# Tâches planifiées internes (rappels + sauvegardes). Mettre false si vous
# utilisez un cron externe qui appelle POST /api/cron/quotidien
CRON_INTERNE=true
CRON_SECRET=un-autre-secret-pour-le-cron-externe

# ---------------- WhatsApp ----------------
# manuel : liens wa.me pré-remplis, envoi en un clic (aucun compte requis)
# meta   : WhatsApp Business Cloud API (Meta)
# twilio : Twilio WhatsApp
WHATSAPP_MODE=manuel

# Meta Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
# Hors fenêtre de 24 h, Meta exige un modèle approuvé. Si renseigné, le
# message est envoyé via ce modèle avec le texte comme unique paramètre {{1}}.
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=fr

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
